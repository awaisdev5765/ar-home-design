rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /projects/{projectId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /designVersions/{versionId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /overlayRegions/{overlayId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /estimates/{estimateId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /materialCatalog/{materialId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /shareLinks/{shareId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /shareRateLimits/{bucketId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
  }
}
